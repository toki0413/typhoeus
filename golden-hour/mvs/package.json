{
  "name": "golden-hour-mvs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5174",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check": "tsc --noEmit && vitest run && vite build && node scripts/check-boundaries.mjs && node scripts/check-bundle.mjs",
    "ci": "npm run check && npm run verify && npm run e2e && npm run verify:a11y",
    "build:firefighter": "blender --background --factory-startup --python assets-src/firefighter/build.py",
    "verify:visual": "node scripts/visual-check.mjs",
    "verify:audio": "node scripts/audio-check-retry.mjs",
    "verify:a11y": "node scripts/a11y-check.mjs",
    "verify": "npm run verify:visual && npm run verify:audio",
    "e2e": "node scripts/e2e-check.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4174"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "axe-core": "^4.14.1",
    "jsdom": "^29.1.1",
    "puppeteer-core": "^24.43.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
