{
  "name": "commons",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "test": "node --test test/unit.test.mjs && node --test test/science.test.mjs && node --test test/fit.test.mjs && node test/app-smoke.mjs && node e2e-test.mjs",
    "test:unit": "node --test test/unit.test.mjs",
    "test:science": "node --test test/science.test.mjs",
    "test:fit": "node --test test/fit.test.mjs",
    "test:smoke": "node test/app-smoke.mjs",
    "test:e2e": "node e2e-test.mjs",
    "audio:render": "node tools/audio-render.cjs",
    "audio:check": "node tools/live-audio-check.cjs",
    "build": "node build.mjs",
    "build:web": "npx esbuild src/app.js --bundle --format=esm --minify --outfile=bundle.js",
    "build:www": "node build.mjs && cp commons.html www/index.html && npx cap sync android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "ios:add": "npm install @capacitor/ios --save && npx cap add ios",
    "ios:sync": "node build.mjs && cp commons.html www/index.html && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "dev": "python3 -m http.server 4173 --bind 0.0.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0"
  }
}
